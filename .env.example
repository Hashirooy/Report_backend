DATABASE_URL=postgresql://postgres:postgres@localhost:5432/report

# --- Authentication ----------------------------------------------------------
# HMAC key for session cookies. At least 32 characters; required in production.
# Changing it signs everyone out.
JWT_SECRET=change-me-to-at-least-32-random-characters
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_NAME=reports_session
# Must be true behind HTTPS; browsers drop secure cookies on plain HTTP.
SESSION_COOKIE_SECURE=false

# Deployment-wide ingest token, valid for every project. Superseded by
# per-project tokens created from the project settings; leave it empty once the
# pipelines have been moved over.
INGEST_TOKEN=
MAX_UPLOAD_BYTES=536870912
MAX_ZIP_ENTRIES=50000
# Largest OpenAPI document accepted by the spec upload. Parsed in memory, so it
# is far below the archive limit above.
MAX_SPEC_BYTES=8388608
PORT=3000

# --- Reps (agent jobs) -------------------------------------------------------
# Agent CLI. Must be installed and authenticated for the worker's user.
REPS_CLI=claude
REPS_MODEL=claude-sonnet-5
# Directory the agent runs in. Must contain .claude/skills; the boot fails if a
# skill the prompts invoke is missing there.
REPS_SKILLS_ROOT=agent-skills
REPS_TASK_TIMEOUT_MS=900000
# Hard spend ceiling per task, in USD. 0 disables it.
REPS_MAX_BUDGET_USD=2
REPS_HEARTBEAT_MS=5000
# Agent jobs one worker runs at once. Each is a whole CLI process.
REPS_CONCURRENCY=1
# Largest document accepted into the database, in bytes.
REPS_MAX_ARTIFACT_BYTES=2097152

# --- Integrations (sending bug reports) --------------------------------------
# Encrypts the credentials integrations send. At least 32 characters; changing
# it makes stored secrets unreadable. Generate: openssl rand -base64 48
INTEGRATIONS_SECRET_KEY=
# Comma-separated hosts allowed to be private or plain http (internal Jira).
# "*.corp.example" matches subdomains. Everything else must be public https.
INTEGRATIONS_ALLOWED_HOSTS=
INTEGRATIONS_TIMEOUT_MS=15000
INTEGRATIONS_MAX_RESPONSE_BYTES=1048576
